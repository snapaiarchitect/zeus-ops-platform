# --- Core ---
NODE_ENV=development
PORT=3001
# Sandbox: leave DATABASE_URL unset (or USE_SQLITE=true) to use a local SQLite file.
# Production: DATABASE_URL is REQUIRED (PostgreSQL).
USE_SQLITE=true
# DATABASE_URL=postgresql://user:pass@host:5432/zeusops
JWT_SECRET=change-me-to-at-least-32-random-characters
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# --- Integrations (all optional; features degrade gracefully when unset) ---
# SendGrid: transactional email (lead notifications, welcome, booking confirmation)
SENDGRID_API_KEY=
FROM_EMAIL=hello@zeusops.com
# Stripe: subscriptions & invoices. Webhooks are REJECTED unless both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Calendly: bookings. Webhooks are REJECTED unless the signing key is set.
CALENDLY_API_KEY=
CALENDLY_WEBHOOK_SECRET=
